---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Ayana Ahuja — Independent Edition",
  description = "Ayana Ahuja — software engineering, quantitative systems, solutions engineering, research, and selected work.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <meta
      name="description"
      content={description}
    />

    <meta
      name="theme-color"
      content="#ffffff"
    />

    <title>{title}</title>
  </head>

  <body>
    <div class="page-shell">
      <slot />
    </div>
  </body>
</html>