---
const substackUrl = "https://ayana301405.substack.com/";

const projects = [
  {
    number: "01",
    category: "Engineering",
    status: "Selected work",
    title: "WasteShark",
    description:
      "A team-built robotic system designed around a real environmental problem. This case study will document the system, constraints, technical decisions, and my contribution.",
  },
  {
    number: "02",
    category: "Quantitative systems",
    status: "In development",
    title: "Market Signals Study",
    description:
      "A research project examining market data, strategy assumptions, risk, and the difference between a convincing chart and a reliable result.",
  },
  {
    number: "03",
    category: "Solutions engineering",
    status: "In development",
    title: "From Discovery to Design",
    description:
      "A technical customer scenario translated into requirements, architecture, tradeoffs, and a working demonstration.",
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />
    <meta
      name="description"
      content="Ayana Ahuja — software engineering, quantitative systems, solutions engineering, research, and selected work."
    />
    <meta name="theme-color" content="#ffffff" />

    <title>Ayana Ahuja — Independent Edition</title>
  </head>

  <body>
    <div class="paper-noise" aria-hidden="true"></div>

    <div class="page-shell">
      <header class="site-header">
        <div class="issue-line">
          <span>Independent Edition</span>
        </div>

        <div class="masthead-row">
          <div class="masthead-identity">
            <a class="masthead" href="/" aria-label="Ayana Ahuja home">
              Ayana Ahuja
            </a>

            <p class="location-line">
              <span aria-hidden="true">📍</span>
              San Francisco
            </p>
          </div>

          <p class="masthead-note">
            Systems | Solutions | Research | Development
          </p>
        </div>

        <nav aria-label="Primary navigation">
          <a href="#work">Selected work</a>
          <a href="#about">About</a>
          <a href="#current">Current focus</a>
          <a
            href={substackUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            Writing ↗
          </a>
          <a href="#contact">Contact</a>
        </nav>
      </header>

      <main>
        <section class="hero" aria-labelledby="hero-title">
          <div class="hero-copy">
            <div class="kicker">
              <span class="kicker-mark" aria-hidden="true"></span>
              Software engineering student
            </div>

            <h1 id="hero-title">
              Building systems and designing
              <span class="accent-word">solutions</span>
              <span class="headline-tail">for complex problems.</span>
            </h1>

            <p class="dek">
              Hi, I’m Ayana :) I’m interested in quantitative systems,
              solutions engineering, and the work of translating complicated
              ideas into something clear, useful, and human.
            </p>

            <div class="hero-actions">
              <a class="button button-dark" href="#work">
                Read selected work
                <span aria-hidden="true">↓</span>
              </a>

              <a class="button button-light" href="#about">
                About the author
              </a>
            </div>

            <div class="byline">
              <span>Written &amp; designed by Ayana Ahuja</span>
            </div>
          </div>

          <figure class="hero-illustration tilt-surface" data-tilt="hero">
            <figcaption>
              Fig. 01 — Structure, rhythm, and technical systems
            </figcaption>

            <div class="red-print red-print-one" aria-hidden="true"></div>
            <div class="red-print red-print-two" aria-hidden="true"></div>
            <div class="score-lines" aria-hidden="true"></div>

            <svg
              class="signal-art"
              viewBox="0 0 760 620"
              role="img"
              aria-label="Layered line illustration combining a waveform, orbital paths, musical notation, and technical systems"
            >
              <defs>
                <linearGradient
                  id="signalInk"
                  x1="40"
                  y1="0"
                  x2="720"
                  y2="0"
                  gradientUnits="userSpaceOnUse"
                >
                  <stop stop-color="#1b1915" stop-opacity="0" />
                  <stop offset="0.18" stop-color="#1b1915" />
                  <stop offset="0.68" stop-color="#9b1212" />
                  <stop offset="1" stop-color="#9b1212" stop-opacity="0" />
                </linearGradient>

                <filter id="roughen">
                  <feTurbulence
                    type="fractalNoise"
                    baseFrequency="0.015"
                    numOctaves="2"
                    seed="7"
                    result="noise"
                  />
                  <feDisplacementMap
                    in="SourceGraphic"
                    in2="noise"
                    scale="1.2"
                  />
                </filter>
              </defs>

              <ellipse
                cx="390"
                cy="315"
                rx="220"
                ry="220"
                fill="none"
                stroke="#1b1915"
                stroke-opacity="0.42"
                stroke-width="1.4"
              />

              <ellipse
                cx="390"
                cy="315"
                rx="300"
                ry="105"
                fill="none"
                stroke="#9b1212"
                stroke-opacity="0.58"
                stroke-width="1.4"
                transform="rotate(18 390 315)"
              />

              <ellipse
                cx="390"
                cy="315"
                rx="270"
                ry="82"
                fill="none"
                stroke="#1b1915"
                stroke-opacity="0.28"
                stroke-width="1"
                transform="rotate(-26 390 315)"
              />

              <path
                d="M40 320
                   C90 320 108 320 136 320
                   C170 320 178 254 211 254
                   C246 254 248 384 284 384
                   C318 384 322 286 356 286
                   C390 286 395 347 430 347
                   C466 347 470 224 505 224
                   C541 224 544 400 580 400
                   C616 400 622 294 655 294
                   C688 294 701 320 720 320"
                fill="none"
                stroke="url(#signalInk)"
                stroke-width="3"
                stroke-linecap="round"
                filter="url(#roughen)"
              />

              <circle
                cx="390"
                cy="315"
                r="67"
                fill="#ffffff"
                stroke="#1b1915"
                stroke-width="1.6"
              />

              <text
                x="390"
                y="334"
                text-anchor="middle"
                fill="#9b1212"
                font-family="Georgia, serif"
                font-size="64"
                font-style="italic"
              >
                A
              </text>

              <g
                fill="#1b1915"
                font-family="'Courier New', monospace"
                font-size="13"
              >
                <text x="76" y="94">structure / rhythm</text>
                <text x="535" y="112">logic / probability</text>
                <text x="84" y="528">design / development</text>
                <text x="535" y="520">systems / solutions</text>
              </g>

              <g
                fill="#9b1212"
                font-family="Georgia, serif"
                font-size="28"
                font-style="italic"
              >
                <text x="142" y="170">tempo</text>
                <text x="550" y="452">pattern</text>
              </g>

              <g
                fill="none"
                stroke="#1b1915"
                stroke-width="1.2"
                opacity="0.7"
              >
                <path d="M149 180 C164 167 183 163 205 167" />
                <path d="M550 462 C580 472 608 470 634 456" />
                <path d="M94 114 L94 198" />
                <path d="M666 120 L666 198" />
              </g>

              <g fill="#1b1915">
                <circle cx="111" cy="202" r="7" />
                <path d="M118 202 V152" stroke="#1b1915" stroke-width="2" />
                <circle cx="646" cy="194" r="7" />
                <path d="M653 194 V144" stroke="#1b1915" stroke-width="2" />
              </g>
            </svg>

            <div class="figure-footer">
              <span>Literature · Music · Technology</span>
              <span>Plate No. 01</span>
            </div>
          </figure>
        </section>

        <section class="section work-section" id="work">
          <div class="section-heading">
            <div>
              <p class="section-number">Section I</p>
              <p class="section-label">Selected work</p>
            </div>

            <h2>
              Technical work with an editorial point of view.
            </h2>
          </div>

          <div class="project-list">
            {
              projects.map((project) => (
                <article class="project-card tilt-surface" data-tilt="card">
                  <div class="project-index">
                    <span>{project.number}</span>
                    <span>{project.status}</span>
                  </div>

                  <div class="project-body">
                    <p class="project-category">{project.category}</p>
                    <h3>{project.title}</h3>
                    <p>{project.description}</p>
                  </div>

                  <a
                    class="project-link"
                    href="#contact"
                    aria-label={`Ask Ayana about ${project.title}`}
                  >
                    Open file
                    <span aria-hidden="true">↗</span>
                  </a>
                </article>
              ))
            }
          </div>
        </section>

        <section class="section about-section" id="about">
          <div class="about-heading">
            <p class="section-number">Section II</p>

            <h2>
              I’m interested in systems, but also in what systems mean to
              people.
            </h2>
          </div>

          <div class="about-columns">
            <div class="about-copy">
              <p class="drop-cap">
                I study software engineering and am currently exploring two
                paths that reward different parts of how I think:
                quantitative trading and solutions engineering.
              </p>

              <p>
                Quantitative work interests me because it forces precision.
                Solutions engineering interests me because precision alone is
                not enough—you also have to understand the person, the problem,
                and the tradeoff.
              </p>

              <p>
                Music and literature shape how I notice rhythm, structure, and
                interpretation. That sensibility carries into my technical
                work, influencing how I organize systems, communicate ideas,
                and shape the visual language of this portfolio.
              </p>
            </div>

            <aside class="pull-quote">
              <span class="quote-mark" aria-hidden="true">“</span>

              <blockquote>
                The goal is not to make complexity disappear. It is to make it
                navigable.
              </blockquote>

              <p>— working principle</p>
            </aside>
          </div>
        </section>

        <section class="section current-section" id="current">
          <div class="section-heading compact">
            <div>
              <p class="section-number">Section III</p>
              <p class="section-label">Current focus</p>
            </div>

            <h2>What I am learning and building now.</h2>
          </div>

          <div class="focus-grid">
            <article>
              <span>01</span>
              <h3>Probability &amp; markets</h3>
              <p>
                Learning how assumptions, risk, transaction costs, and
                overfitting change the interpretation of a strategy.
              </p>
            </article>

            <article>
              <span>02</span>
              <h3>Technical discovery</h3>
              <p>
                Practising how to turn an unclear business problem into useful
                questions, requirements, architecture, and tradeoffs.
              </p>
            </article>

            <article>
              <span>03</span>
              <h3>Software foundations</h3>
              <p>
                Strengthening Java, Python, data structures, and the habit of
                explaining technical decisions clearly.
              </p>
            </article>
          </div>
        </section>

        <section class="section writing-section" id="writing">
          <div class="writing-label">
            <p class="section-number">Section IV</p>
            <p class="section-label">Field notes</p>
          </div>

          <div class="writing-copy">
            <p class="edition-tag">Published in The Human Variable</p>

            <h2>
              Longer thoughts, observations, and work in progress.
            </h2>

            <p>
              My writing is a separate space for ideas that need more room than
              a project card: reflections, research notes, creative work, and
              questions I am still thinking through.
            </p>

            <a
              class="substack-link"
              href={substackUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              Read The Human Variable
              <span aria-hidden="true">↗</span>
            </a>
          </div>

          <div class="writing-mark" aria-hidden="true">
            <span>&lt;/&gt;</span>
            <span>¶</span>
            <span>∞</span>
          </div>
        </section>

        <section class="contact-section" id="contact">
          <div class="contact-intro">
            <p class="section-number">Correspondence</p>
            <h2>Let’s exchange ideas.</h2>

            <p>
              I’m always open to a good conversation. Reach out about
              internships, technical projects, quantitative systems, solutions
              engineering, collaborative art or technology ideas, or simply to
              exchange thoughts.
            </p>

            <p>
              I’m especially interested in connecting with people who care
              about youth mental health advocacy and encouraging more girls to
              pursue STEM.
            </p>
          </div>

          <form
            class="contact-form"
            name="portfolio-contact"
            method="POST"
            data-netlify="true"
            netlify-honeypot="bot-field"
            data-netlify-recaptcha="true"
          >
            <input
              type="hidden"
              name="form-name"
              value="portfolio-contact"
            />

            <p class="form-hidden">
              <label>
                Leave this field empty if you are human:
                <input
                  type="text"
                  name="bot-field"
                  tabindex="-1"
                  autocomplete="off"
                />
              </label>
            </p>

            <div class="form-grid">
              <label>
                <span>Name</span>
                <input
                  type="text"
                  name="name"
                  autocomplete="name"
                  required
                />
              </label>

              <label>
                <span>Email</span>
                <input
                  type="email"
                  name="email"
                  autocomplete="email"
                  required
                />
              </label>
            </div>

            <label>
              <span>What would you like to discuss?</span>

              <select name="topic" required>
                <option value="" selected disabled>Select a topic</option>
                <option value="internship">Internship or opportunity</option>
                <option value="technical-project">Technical project</option>
                <option value="quantitative-systems">
                  Quantitative systems
                </option>
                <option value="solutions-engineering">
                  Solutions engineering
                </option>
                <option value="advocacy">
                  Youth mental health or girls in STEM
                </option>
                <option value="creative-collaboration">
                  Art or technology collaboration
                </option>
                <option value="other">Something else</option>
              </select>
            </label>

            <label>
              <span>Message</span>

              <textarea
                name="message"
                rows="7"
                required
              ></textarea>
            </label>

            <div
              class="captcha-wrap"
              data-netlify-recaptcha="true"
            ></div>

            <div class="form-footer">
              <p>
                Protected with spam filtering, a hidden bot trap, and human
                verification after deployment.
              </p>

              <button type="submit">
                Send correspondence
                <span aria-hidden="true">↗</span>
              </button>
            </div>
          </form>
        </section>
      </main>

      <footer>
        <span>© Ayana Ahuja</span>
        <span>Typeset for the web · Built with Astro</span>
      </footer>
    </div>

    <script>
      const tiltItems = document.querySelectorAll<HTMLElement>("[data-tilt]");

      const reducedMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches;

      if (!reducedMotion) {
        tiltItems.forEach((item) => {
          const isHero = item.dataset.tilt === "hero";
          const maxTilt = isHero ? 7 : 2.5;

          item.addEventListener("pointermove", (event) => {
            const bounds = item.getBoundingClientRect();
            const x = (event.clientX - bounds.left) / bounds.width;
            const y = (event.clientY - bounds.top) / bounds.height;
            const rotateY = (x - 0.5) * maxTilt * 2;
            const rotateX = (0.5 - y) * maxTilt * 2;

            item.style.setProperty("--tilt-x", `${rotateX}deg`);
            item.style.setProperty("--tilt-y", `${rotateY}deg`);
            item.style.setProperty("--pointer-x", `${x * 100}%`);
            item.style.setProperty("--pointer-y", `${y * 100}%`);
          });

          item.addEventListener("pointerleave", () => {
            item.style.setProperty("--tilt-x", "0deg");
            item.style.setProperty("--tilt-y", "0deg");
            item.style.setProperty("--pointer-x", "50%");
            item.style.setProperty("--pointer-y", "50%");
          });
        });
      }
    </script>
  </body>
</html>

<style>
  @import url("https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400;1,6..72,500&display=swap");

  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    scroll-behavior: smooth;
  }

  :global(body) {
    margin: 0;
    min-width: 320px;
    overflow-x: hidden;
    background: #ffffff;
    color: #161616;
    font-family: "Newsreader", Georgia, serif;
    text-rendering: optimizeLegibility;
    -webkit-font-smoothing: antialiased;
  }

  :global(::selection) {
    background: #161616;
    color: #ffffff;
  }

  :global(a) {
    color: inherit;
    text-decoration: none;
  }

  :global(button),
  :global(input),
  :global(select),
  :global(textarea) {
    font: inherit;
  }

  :global(button),
  :global(a) {
    -webkit-tap-highlight-color: transparent;
  }

  .paper-noise {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    opacity: 0.42;
    background-image:
      repeating-linear-gradient(
        0deg,
        rgba(22, 22, 22, 0.014) 0,
        rgba(22, 22, 22, 0.014) 1px,
        transparent 1px,
        transparent 5px
      ),
      radial-gradient(circle at 7% 14%, rgba(155, 18, 18, 0.08), transparent 17rem),
      radial-gradient(circle at 93% 82%, rgba(155, 18, 18, 0.07), transparent 20rem);
  }

  .paper-noise::before,
  .paper-noise::after {
    position: absolute;
    content: "";
    border: 1px solid rgba(155, 18, 18, 0.42);
    pointer-events: none;
  }

  .paper-noise::before {
    top: 88px;
    left: -38px;
    width: 150px;
    height: 150px;
    transform: rotate(20deg);
  }

  .paper-noise::after {
    right: -48px;
    bottom: 85px;
    width: 190px;
    height: 86px;
    transform: rotate(-15deg);
  }

  .page-shell {
    width: min(calc(100% - 42px), 1180px);
    margin-inline: auto;
  }

  .site-header {
    position: relative;
    padding-top: 10px;
  }

  .issue-line {
    display: flex;
    justify-content: center;
    padding: 5px 0;
    border-top: 1px solid #161616;
    border-bottom: 1px solid rgba(22, 22, 22, 0.52);
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.58rem;
    letter-spacing: 0.12em;
    text-align: center;
    text-transform: uppercase;
  }

  .masthead-row {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: end;
    gap: 24px;
    padding: 11px 0 9px;
    border-bottom: 4px double #161616;
  }

  .masthead-identity {
    display: grid;
    justify-items: start;
    gap: 4px;
  }

  .masthead {
    font-size: clamp(2.9rem, 5.7vw, 5.5rem);
    font-weight: 500;
    letter-spacing: -0.07em;
    line-height: 0.86;
  }

  .masthead-note {
    max-width: 360px;
    margin: 0 0 3px;
    color: #333;
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.58rem;
    letter-spacing: 0.08em;
    line-height: 1.45;
    text-align: right;
    text-transform: uppercase;
  }

  .location-line {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    margin: 0;
    color: #4b4b4b;
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.58rem;
    font-weight: 500;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .location-line span {
    font-size: 0.95rem;
    line-height: 1;
  }

  nav {
    position: sticky;
    top: 0;
    z-index: 20;
    display: flex;
    justify-content: center;
    gap: 28px;
    padding: 8px 0 7px;
    border-bottom: 1px solid #161616;
    background: rgba(255, 255, 255, 0.96);
    backdrop-filter: blur(10px);
  }

  nav a {
    position: relative;
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.64rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  nav a::after {
    position: absolute;
    right: 0;
    bottom: -4px;
    left: 0;
    height: 1px;
    content: "";
    background: #9b1212;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 180ms ease;
  }

  nav a:hover::after,
  nav a:focus-visible::after {
    transform: scaleX(1);
  }

  .hero {
    display: grid;
    min-height: 750px;
    grid-template-columns: minmax(0, 1.03fr) minmax(380px, 0.97fr);
    align-items: center;
    gap: 68px;
    padding: 70px 0 76px;
    border-bottom: 4px double #161616;
  }

  .hero-copy {
    min-width: 0;
  }

  .kicker {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 24px;
    color: #4f4f4f;
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.66rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .kicker-mark {
    width: 21px;
    height: 1px;
    background: #9b1212;
  }

  h1,
  h2,
  h3,
  p {
    margin-top: 0;
  }

  h1 {
    max-width: 760px;
    margin-bottom: 28px;
    font-size: clamp(4.3rem, 7.1vw, 7.1rem);
    font-weight: 400;
    letter-spacing: -0.075em;
    line-height: 0.82;
  }

  .accent-word {
    display: inline-block;
    padding: 0 0.08em 0.02em;
    background: rgba(94, 94, 94, 0.16);
    color: #161616;
    font-style: italic;
    text-decoration: none;
    transform: rotate(-1deg);
  }

  .headline-tail {
    display: block;
  }

  .dek {
    max-width: 650px;
    margin-bottom: 30px;
    padding-top: 21px;
    border-top: 1px solid rgba(22, 22, 22, 0.5);
    color: #3d3d3d;
    font-size: clamp(1.08rem, 1.55vw, 1.28rem);
    line-height: 1.58;
  }

  .dek::first-letter {
    float: left;
    margin: 8px 8px 0 0;
    color: #9b1212;
    font-size: 3.8rem;
    line-height: 0.7;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 34px;
  }

  .button {
    display: inline-flex;
    min-height: 48px;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: 0 18px;
    border: 1px solid #161616;
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    transition:
      transform 180ms ease,
      background 180ms ease,
      color 180ms ease;
  }

  .button:hover,
  .button:focus-visible {
    transform: translateY(-2px);
  }

  .button-dark {
    background: #161616;
    color: #ffffff;
  }

  .button-light {
    background: transparent;
  }

  .button-light:hover,
  .button-light:focus-visible {
    background: #161616;
