---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";

const projects = [
  {
    number: "01",
    category: "Engineering system",
    status: "Project complete",
    title: "WasteShark",
    description:
      "An autonomous aquatic debris collection system combining software, electrical systems, MQTT communication, and physical design.",
    href: "",
    linkLabel: "Case study in preparation",
    available: false,
  },
  {
    number: "02",
    category: "Quantitative research",
    status: "Project complete",
    title: "SPY One-Day Dip-Reversion Backtest",
    description:
      "A Python study testing next-session SPY performance after large daily declines while the price remains above its 200-day moving average.",
    href: "/work/spy-backtest",
    linkLabel: "Open project",
    available: true,
  },
  {
    number: "03",
    category: "Software",
    status: "Project complete",
    title: "Digital Chess Game",
    description:
      "A Java chess game with a graphical interface, complete move rules, undo functionality, game-state tracking, and automated testing.",
    href: "/work/digital-chess",
    linkLabel: "Open project",
    available: true,
  },
  {
    number: "04",
    category: "Generative AI · Financial technology",
    status: "Early development",
    title: "Financial Advisor Copilot",
    description:
      "An financial advisor/ financial planner facing generative AI concept that converts approved client conversations into structured financial profiles and draft portfolio scenarios for advisor review.",
    href: "",
    linkLabel: "Currently developing",
    available: false,
  },
];
---

<BaseLayout
  title="Work — Ayana Ahuja"
  description="Software, engineering, quantitative research, and technical projects by Ayana Ahuja."
>
  <Header />

  <main>
    <section class="page-hero">
      <p class="eyebrow">Project archive</p>

      <div>
        <h1>My Projects</h1>

        <p class="page-intro">
          A focused archive of completed software, engineering, and quantitative
          work, alongside one system currently in development.
        </p>
      </div>
    </section>

    <section class="section">
      <div class="section-heading">
        <div>
          <p class="section-number">01</p>
          <p class="section-label">Selected projects</p>
        </div>

        <h2>Built, tested, and still evolving.</h2>
      </div>

      <div class="work-grid">
        {
          projects.map((project) => (
            <article
              class:list={[
                "work-card",
                { "in-development": project.status === "Early development" },
              ]}
            >
              <div class="work-card-top">
                <span class="work-number">{project.number}</span>
                <span>{project.status}</span>
              </div>

              <p class="project-category">{project.category}</p>
              <h3>{project.title}</h3>
              <p class="work-description">{project.description}</p>

              {
                project.available ? (
                  <a class="project-link" href={project.href}>
                    {project.linkLabel}
                    <span aria-hidden="true">↗</span>
                  </a>
                ) : (
                  <span class="project-status">{project.linkLabel}</span>
                )
              }
            </article>
          ))
        }
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .work-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    border-top: 1px solid var(--ink);
    border-left: 1px solid var(--ink);
  }

  .work-card {
    position: relative;
    min-height: 370px;
    padding: 30px;
    overflow: hidden;
    border-right: 1px solid var(--ink);
    border-bottom: 1px solid var(--ink);
    background:
      linear-gradient(
        135deg,
        transparent 0 79%,
        rgba(151, 23, 23, 0.06) 79% 100%
      ),
      rgba(255, 255, 255, 0.72);
  }

  .work-card::after {
    position: absolute;
    right: 24px;
    bottom: 24px;
    width: 66px;
    height: 66px;
    content: "";
    border: 1px solid rgba(23, 23, 23, 0.38);
    background:
      radial-gradient(var(--ink) 0.8px, transparent 0.8px);
    background-size: 7px 7px;
    opacity: 0.22;
    transform: rotate(10deg);
  }

  .work-card.in-development {
    background:
      repeating-linear-gradient(
        -45deg,
        transparent 0,
        transparent 13px,
        rgba(151, 23, 23, 0.028) 13px,
        rgba(151, 23, 23, 0.028) 14px
      ),
      rgba(255, 250, 246, 0.78);
  }

  .work-card-top {
    display: flex;
    justify-content: space-between;
    gap: 18px;
    margin-bottom: 68px;
    color: var(--muted-ink);
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.56rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .work-number {
    color: var(--accent);
    font-weight: 500;
  }

  .work-card h3 {
    max-width: 560px;
    margin-bottom: 14px;
    font-size: clamp(2.3rem, 3.7vw, 4rem);
    font-weight: 400;
    letter-spacing: -0.055em;
    line-height: 0.92;
  }

  .work-description {
    position: relative;
    z-index: 2;
    max-width: 570px;
    margin-bottom: 28px;
    color: #404040;
    font-size: 1.02rem;
    line-height: 1.6;
  }

  .work-card .project-link,
  .project-status {
    position: relative;
    z-index: 2;
  }

  .project-status {
    display: inline-flex;
    padding: 9px 11px;
    border: 1px solid var(--line);
    color: var(--muted-ink);
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.56rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  @media (max-width: 760px) {
    .work-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
