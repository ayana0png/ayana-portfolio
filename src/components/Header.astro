---
const substackUrl = "https://ayana301405.substack.com/";
---

<header class="site-header">
  <div class="edition-line">
    Independent Edition
  </div>

  <div class="masthead-row">
    <div class="masthead-identity">
      <a
        class="masthead"
        href="/"
        aria-label="Ayana Ahuja home"
      >
        Ayana Ahuja
      </a>

      <p class="location-line">
        <span
          class="location-pin"
          aria-hidden="true"
        >
          ⚲
        </span>

        San Francisco
      </p>
    </div>

    <p class="masthead-note">
      Systems | Solutions | Research | Development
    </p>
  </div>

  <nav
    class="site-nav"
    aria-label="Primary navigation"
  >
    <a href="/">Home</a>

    <a href="/work">
      Work
    </a>

    <a href="/#about">
      About
    </a>

    <a
      href={substackUrl}
      target="_blank"
      rel="noopener noreferrer"
    >
      Writing ↗
    </a>

    <a href="/#contact">
      Contact
    </a>
  </nav>
</header>