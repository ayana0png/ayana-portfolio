---
const year = new Date().getFullYear();

const projects = [
  {
    number: "01",
    category: "Engineering",
    status: "Selected work",
    title: "WasteShark",
    description:
      "A team-built robotic system designed around a real environmental problem. This case study will document the system, constraints, technical decisions, and my contribution.",
  },
  {
    number: "02",
    category: "Quantitative systems",
    status: "In development",
    title: "Market Signals Study",
    description:
      "A research project examining market data, strategy assumptions, risk, and the difference between a convincing chart and a reliable result.",
  },
  {
    number: "03",
    category: "Solutions engineering",
    status: "In development",
    title: "From Discovery to Design",
    description:
      "A technical customer scenario translated into requirements, architecture, tradeoffs, and a working demonstration.",
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />
    <meta
      name="description"
      content="Ayana Ahuja — software engineering, quantitative systems, solutions engineering, and selected creative work."
    />
    <meta name="theme-color" content="#efe6d1" />

    <title>Ayana Ahuja — Portfolio & Selected Works</title>
  </head>

  <body>
    <div class="paper-noise" aria-hidden="true"></div>

    <div class="page-shell">
      <header class="site-header">
        <div class="issue-line">
          <span>Vol. I · Issue 01</span>
          <span>California</span>
          <span>{year}</span>
        </div>

        <div class="masthead-row">
          <a class="masthead" href="/" aria-label="Ayana Ahuja home">
            Ayana Ahuja
          </a>

          <p class="masthead-note">
            Software engineering, systems, words &amp; sound
          </p>
        </div>

        <nav aria-label="Primary navigation">
          <a href="#work">Selected work</a>
          <a href="#about">About</a>
          <a href="#current">Current focus</a>
          <a href="#contact">Contact</a>
        </nav>
      </header>

      <main>
        <section class="hero" aria-labelledby="hero-title">
          <div class="hero-copy">
            <div class="kicker">
              <span class="kicker-mark" aria-hidden="true"></span>
              Software engineering student
            </div>

            <h1 id="hero-title">
              Systems, stories,
              <span class="accent-word">signals</span>
              <span class="headline-tail">and the spaces between them.</span>
            </h1>

            <p class="dek">
              I’m Ayana. I’m interested in quantitative systems, solutions
              engineering, and the work of translating complicated ideas into
              something clear, useful, and human.
            </p>

            <div class="hero-actions">
              <a class="button button-dark" href="#work">
                Read selected work
                <span aria-hidden="true">↓</span>
              </a>

              <a class="button button-light" href="#about">
                About the author
              </a>
            </div>

            <div class="byline">
              <span>Written &amp; designed by Ayana Ahuja</span>
              <span>Last revised · {year}</span>
            </div>
          </div>

          <figure class="hero-illustration">
            <figcaption>
              Fig. 01 — A study in rhythm, probability, and systems
            </figcaption>

            <div class="score-lines" aria-hidden="true"></div>

            <svg
              class="signal-art"
              viewBox="0 0 760 620"
              role="img"
              aria-label="Abstract line illustration combining a waveform, orbital paths, musical notation, and technical markings"
            >
              <defs>
                <linearGradient
                  id="signalInk"
                  x1="40"
                  y1="0"
                  x2="720"
                  y2="0"
                  gradientUnits="userSpaceOnUse"
                >
                  <stop stop-color="#1b1915" stop-opacity="0" />
                  <stop offset="0.18" stop-color="#1b1915" />
                  <stop offset="0.68" stop-color="#7b2f2f" />
                  <stop offset="1" stop-color="#7b2f2f" stop-opacity="0" />
                </linearGradient>

                <filter id="roughen">
                  <feTurbulence
                    type="fractalNoise"
                    baseFrequency="0.015"
                    numOctaves="2"
                    seed="7"
                    result="noise"
                  />
                  <feDisplacementMap
                    in="SourceGraphic"
                    in2="noise"
                    scale="1.2"
                  />
                </filter>
              </defs>

              <ellipse
                cx="390"
                cy="315"
                rx="220"
                ry="220"
                fill="none"
                stroke="#1b1915"
                stroke-opacity="0.42"
                stroke-width="1.4"
              />

              <ellipse
                cx="390"
                cy="315"
                rx="300"
                ry="105"
                fill="none"
                stroke="#7b2f2f"
                stroke-opacity="0.58"
                stroke-width="1.4"
                transform="rotate(18 390 315)"
              />

              <ellipse
                cx="390"
                cy="315"
                rx="270"
                ry="82"
                fill="none"
                stroke="#1b1915"
                stroke-opacity="0.28"
                stroke-width="1"
                transform="rotate(-26 390 315)"
              />

              <path
                d="M40 320
                   C90 320 108 320 136 320
                   C170 320 178 254 211 254
                   C246 254 248 384 284 384
                   C318 384 322 286 356 286
                   C390 286 395 347 430 347
                   C466 347 470 224 505 224
                   C541 224 544 400 580 400
                   C616 400 622 294 655 294
                   C688 294 701 320 720 320"
                fill="none"
                stroke="url(#signalInk)"
                stroke-width="3"
                stroke-linecap="round"
                filter="url(#roughen)"
              />

              <circle
                cx="390"
                cy="315"
                r="67"
                fill="#efe6d1"
                stroke="#1b1915"
                stroke-width="1.6"
              />

              <text
                x="390"
                y="334"
                text-anchor="middle"
                fill="#7b2f2f"
                font-family="Georgia, serif"
                font-size="64"
                font-style="italic"
              >
                A
              </text>

              <g
                fill="#1b1915"
                font-family="'Courier New', monospace"
                font-size="13"
              >
                <text x="76" y="94">frequency / form</text>
                <text x="535" y="112">μ = E[X]</text>
                <text x="84" y="528">~~~~~~</text>
                <text x="535" y="520">signal ≠ certainty</text>
              </g>

              <g
                fill="#7b2f2f"
                font-family="Georgia, serif"
                font-size="28"
                font-style="italic"
              >
                <text x="142" y="170">andante</text>
                <text x="550" y="452">probability</text>
              </g>

              <g
                fill="none"
                stroke="#1b1915"
                stroke-width="1.2"
                opacity="0.7"
              >
                <path d="M149 180 C164 167 183 163 205 167" />
                <path d="M550 462 C580 472 608 470 634 456" />
                <path d="M94 114 L94 198" />
                <path d="M666 120 L666 198" />
              </g>

              <g fill="#1b1915">
                <circle cx="111" cy="202" r="7" />
                <path d="M118 202 V152" stroke="#1b1915" stroke-width="2" />
                <circle cx="646" cy="194" r="7" />
                <path d="M653 194 V144" stroke="#1b1915" stroke-width="2" />
              </g>
            </svg>

            <div class="figure-footer">
              <span>Literature · Music · Technology</span>
              <span>Plate No. 01</span>
            </div>
          </figure>
        </section>

        <section class="section work-section" id="work">
          <div class="section-heading">
            <div>
              <p class="section-number">Section I</p>
              <p class="section-label">Selected work</p>
            </div>

            <h2>
              Technical work with an editorial point of view.
            </h2>
          </div>

          <div class="project-list">
            {
              projects.map((project) => (
                <article class="project-card">
                  <div class="project-index">
                    <span>{project.number}</span>
                    <span>{project.status}</span>
                  </div>

                  <div class="project-body">
                    <p class="project-category">{project.category}</p>
                    <h3>{project.title}</h3>
                    <p>{project.description}</p>
                  </div>

                  <a
                    class="project-link"
                    href="#contact"
                    aria-label={`Ask Ayana about ${project.title}`}
                  >
                    Open file
                    <span aria-hidden="true">↗</span>
                  </a>
                </article>
              ))
            }
          </div>
        </section>

        <section class="section about-section" id="about">
          <div class="about-heading">
            <p class="section-number">Section II</p>
            <h2>
              I’m interested in systems, but also in what systems mean to
              people.
            </h2>
          </div>

          <div class="about-columns">
            <div class="about-copy">
              <p class="drop-cap">
                I study software engineering and am currently exploring two
                paths that reward different parts of how I think:
                quantitative trading and solutions engineering.
              </p>

              <p>
                Quantitative work interests me because it forces precision.
                Solutions engineering interests me because precision alone is
                not enough—you also have to understand the person, the problem,
                and the tradeoff.
              </p>

              <p>
                Music and literature shape how I notice rhythm, structure, and
                interpretation. They are not separate from my technical work;
                they influence how I organize information and explain ideas.
              </p>
            </div>

            <aside class="pull-quote">
              <span class="quote-mark" aria-hidden="true">“</span>
              <blockquote>
                The goal is not to make complexity disappear. It is to make it
                navigable.
              </blockquote>
              <p>— working principle</p>
            </aside>
          </div>
        </section>

        <section class="section current-section" id="current">
          <div class="section-heading compact">
            <div>
              <p class="section-number">Section III</p>
              <p class="section-label">Current focus</p>
            </div>

            <h2>What I am learning and building now.</h2>
          </div>

          <div class="focus-grid">
            <article>
              <span>01</span>
              <h3>Probability &amp; markets</h3>
              <p>
                Learning how assumptions, risk, transaction costs, and
                overfitting change the interpretation of a strategy.
              </p>
            </article>

            <article>
              <span>02</span>
              <h3>Technical discovery</h3>
              <p>
                Practising how to turn an unclear business problem into useful
                questions, requirements, architecture, and tradeoffs.
              </p>
            </article>

            <article>
              <span>03</span>
              <h3>Software foundations</h3>
              <p>
                Strengthening Java, Python, data structures, and the habit of
                explaining technical decisions clearly.
              </p>
            </article>
          </div>
        </section>

        <section class="contact-section" id="contact">
          <div>
            <p class="section-number">Correspondence</p>
            <h2>Let’s exchange ideas.</h2>
          </div>

          <div class="contact-copy">
            <p>
              I’m open to conversations about internships, technical projects,
              quantitative systems, solutions engineering, and collaborative
              work.
            </p>

            <a class="email-link" href="mailto:your-email@example.com">
             ayana070907@gmail.com
              <span aria-hidden="true">↗</span>
            </a>

            <p class="contact-note">
              Replace this placeholder with your real email before publishing.
            </p>
          </div>
        </section>
      </main>

      <footer>
        <span>© {year} Ayana Ahuja</span>
        <span>Typeset for the web · Built with Astro</span>
      </footer>
    </div>
  </body>
</html>

<style>
  @import url("https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400;1,6..72,500&display=swap");

  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    scroll-behavior: smooth;
  }

  :global(body) {
    margin: 0;
    min-width: 320px;
    overflow-x: hidden;
    background: #efe6d1;
    color: #1b1915;
    font-family: "Newsreader", Georgia, serif;
    text-rendering: optimizeLegibility;
    -webkit-font-smoothing: antialiased;
  }

  :global(body::selection),
  :global(::selection) {
    background: #7b2f2f;
    color: #fff8e9;
  }

  :global(a) {
    color: inherit;
    text-decoration: none;
  }

  :global(button),
  :global(a) {
    -webkit-tap-highlight-color: transparent;
  }

  .paper-noise {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    opacity: 0.42;
    background-image:
      repeating-linear-gradient(
        0deg,
        rgba(27, 25, 21, 0.018) 0,
        rgba(27, 25, 21, 0.018) 1px,
        transparent 1px,
        transparent 5px
      ),
      radial-gradient(
        circle at 15% 8%,
        rgba(123, 47, 47, 0.07),
        transparent 30rem
      ),
      radial-gradient(
        circle at 88% 24%,
        rgba(37, 55, 62, 0.06),
        transparent 27rem
      );
  }

  .page-shell {
    width: min(calc(100% - 42px), 1180px);
    margin-inline: auto;
  }

  .site-header {
    position: relative;
    padding-top: 18px;
  }

  .issue-line {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 20px;
    padding: 8px 0;
    border-top: 1px solid #1b1915;
    border-bottom: 1px solid rgba(27, 25, 21, 0.48);
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .issue-line span:nth-child(2) {
    text-align: center;
  }

  .issue-line span:last-child {
    text-align: right;
  }

  .masthead-row {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: end;
    gap: 30px;
    padding: 18px 0 13px;
    border-bottom: 4px double #1b1915;
  }

  .masthead {
    font-size: clamp(3.2rem, 7vw, 6.8rem);
    font-weight: 500;
    letter-spacing: -0.075em;
    line-height: 0.82;
  }

  .masthead-note {
    max-width: 260px;
    margin: 0 0 5px;
    color: #655e51;
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    line-height: 1.6;
    text-align: right;
    text-transform: uppercase;
  }

  nav {
    position: sticky;
    top: 0;
    z-index: 20;
    display: flex;
    justify-content: center;
    gap: 34px;
    padding: 11px 0 10px;
    border-bottom: 1px solid #1b1915;
    background: rgba(239, 230, 209, 0.94);
    backdrop-filter: blur(10px);
  }

  nav a {
    position: relative;
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.66rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  nav a::after {
    position: absolute;
    right: 0;
    bottom: -4px;
    left: 0;
    height: 1px;
    content: "";
    background: #7b2f2f;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 180ms ease;
  }

  nav a:hover::after,
  nav a:focus-visible::after {
    transform: scaleX(1);
  }

  .hero {
    display: grid;
    min-height: 720px;
    grid-template-columns: minmax(0, 1.04fr) minmax(360px, 0.96fr);
    align-items: center;
    gap: 68px;
    padding: 70px 0 76px;
    border-bottom: 4px double #1b1915;
  }

  .hero-copy {
    min-width: 0;
  }

  .kicker {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 24px;
    color: #655e51;
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.66rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .kicker-mark {
    width: 21px;
    height: 1px;
    background: #7b2f2f;
  }

  h1,
  h2,
  h3,
  p {
    margin-top: 0;
  }

  h1 {
    max-width: 760px;
    margin-bottom: 28px;
    font-size: clamp(4.4rem, 7.4vw, 7.4rem);
    font-weight: 400;
    letter-spacing: -0.075em;
    line-height: 0.82;
  }

  .accent-word {
    color: #7b2f2f;
    font-style: italic;
  }

  .headline-tail {
    display: block;
  }

  .dek {
    max-width: 650px;
    margin-bottom: 30px;
    padding-top: 21px;
    border-top: 1px solid rgba(27, 25, 21, 0.48);
    color: #49443b;
    font-size: clamp(1.08rem, 1.55vw, 1.28rem);
    line-height: 1.58;
  }

  .dek::first-letter {
    float: left;
    margin: 8px 8px 0 0;
    color: #7b2f2f;
    font-size: 3.8rem;
    line-height: 0.7;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 34px;
  }

  .button {
    display: inline-flex;
    min-height: 48px;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: 0 18px;
    border: 1px solid #1b1915;
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    transition:
      transform 180ms ease,
      background 180ms ease,
      color 180ms ease;
  }

  .button:hover,
  .button:focus-visible {
    transform: translateY(-2px);
  }

  .button-dark {
    background: #1b1915;
    color: #f7efdc;
  }

  .button-light {
    background: transparent;
  }

  .button-light:hover,
  .button-light:focus-visible {
    background: #7b2f2f;
    color: #f7efdc;
  }

  .byline {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 20px;
    padding-top: 13px;
    border-top: 1px solid rgba(27, 25, 21, 0.28);
    color: #71695b;
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.57rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .hero-illustration {
    position: relative;
    min-width: 0;
    min-height: 610px;
    margin: 0;
    overflow: hidden;
    border: 1px solid #1b1915;
    background: #e5dac1;
    box-shadow:
      11px 11px 0 rgba(27, 25, 21, 0.09),
      inset 0 0 0 8px #efe6d1,
      inset 0 0 0 9px #1b1915;
  }

  .hero-illustration figcaption {
    position: absolute;
    top: 20px;
    right: 22px;
    left: 22px;
    z-index: 4;
    padding-bottom: 9px;
    border-bottom: 1px solid rgba(27, 25, 21, 0.42);
    color: #5e574a;
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.56rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .score-lines {
    position: absolute;
    inset: 80px 18px 62px;
    background: repeating-linear-gradient(
      to bottom,
      transparent 0,
      transparent 35px,
      rgba(27, 25, 21, 0.09) 35px,
      rgba(27, 25, 21, 0.09) 36px
    );
  }

  .signal-art {
    position: absolute;
    inset: 61px 4% 54px;
    width: 92%;
    height: calc(100% - 115px);
  }

  .figure-footer {
    position: absolute;
    right: 22px;
    bottom: 19px;
    left: 22px;
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding-top: 9px;
    border-top: 1px solid rgba(27, 25, 21, 0.42);
    color: #5e574a;
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.54rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .section {
    padding: 105px 0;
    border-bottom: 1px solid #1b1915;
  }

  .section-heading {
    display: grid;
    grid-template-columns: 0.38fr 1.62fr;
    gap: 52px;
    margin-bottom: 48px;
  }

  .section-heading.compact {
    margin-bottom: 38px;
  }

  .section-number,
  .section-label {
    margin-bottom: 7px;
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.61rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .section-number {
    color: #7b2f2f;
  }

  .section-label {
    color: #655e51;
  }

  .section-heading h2,
  .about-heading h2,
  .contact-section h2 {
    margin-bottom: 0;
    font-size: clamp(3.2rem, 5.7vw, 6rem);
    font-weight: 400;
    letter-spacing: -0.065em;
    line-height: 0.9;
  }

  .project-list {
    border-top: 1px solid #1b1915;
  }

  .project-card {
    display: grid;
    grid-template-columns: 0.25fr 1.35fr auto;
    gap: 35px;
    align-items: end;
    padding: 34px 0;
    border-bottom: 1px solid rgba(27, 25, 21, 0.46);
    transition:
      padding 180ms ease,
      background 180ms ease;
  }

  .project-card:hover {
    padding-right: 18px;
    padding-left: 18px;
    background: rgba(123, 47, 47, 0.045);
  }

  .project-index {
    align-self: stretch;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 30px;
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.58rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .project-index span:first-child {
    color: #7b2f2f;
    font-size: 1rem;
  }

  .project-index span:last-child {
    color: #70685a;
  }

  .project-category {
    margin-bottom: 8px;
    color: #7b2f2f;
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.59rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .project-body h3 {
    margin-bottom: 10px;
    font-size: clamp(2.3rem, 4.3vw, 4.7rem);
    font-weight: 400;
    letter-spacing: -0.055em;
    line-height: 0.9;
  }

  .project-body > p:last-child {
    max-width: 690px;
    margin-bottom: 0;
    color: #514b40;
    font-size: 1.02rem;
    line-height: 1.6;
  }

  .project-link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    white-space: nowrap;
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.61rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .project-link span {
    color: #7b2f2f;
    font-size: 1rem;
  }

  .about-section {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 74px;
  }

  .about-heading h2 {
    max-width: 560px;
  }

  .about-columns {
    display: grid;
    gap: 46px;
