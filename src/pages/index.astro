---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const featuredProjects = [
  {
    number: "01",
    category: "Engineering system",
    status: "Case study",
    title: "WasteShark",
    description:
      "An autonomous aquatic debris collection system combining software, electrical systems, MQTT communication, and physical design.",
    href: "/work/wasteshark",
    available: true,
  },
  {
    number: "02",
    category: "Quantitative research",
    status: "Project complete",
    title: "SPY One-Day Dip-Reversion Backtest",
    description:
      "A Python study testing next-session SPY performance after large daily declines while price remains above its 200-day moving average.",
    href: "/work/spy-backtest",
    available: true,
  },
  {
    number: "03",
    category: "Software",
    status: "Project complete",
    title: "Digital Chess Game",
    description:
      "A Java chess game with a graphical interface, complete movement rules, undo functionality, game-state tracking, and automated testing.",
    href: "/work/digital-chess",
    available: true,
  },
];

const softwareProjects = [
  {
    number: "S1",
    category: "Software",
    status: "Page ready",
    title: "Digital Chess Game",
    description:
      "A Java chess game with a graphical interface, complete move rules, undo functionality, and automated testing.",
    href: "/work/digital-chess",
    available: true,
  },
  {
    number: "S2",
    category: "Quantitative systems",
    status: "Page ready",
    title: "SPY One-Day Dip-Reversion Backtest",
    description:
      "Testing next-session SPY rebounds after declines greater than 2% while price remains above its 200-day moving average.",
    href: "/work/spy-backtest",
    available: true,
  },
  {
    number: "S3",
    category: "Software project",
    status: "Coming soon",
    title: "Financial Advisor Copilot",
description: "An advisor-facing generative AI system that transforms client-approved meeting notes and transcripts into a structured financial profile. It identifies goals, risk tolerance, time horizon, liquidity needs, investment preferences, and constraints, then generates draft portfolio scenarios with clear rationale and tradeoffs for advisor validation and discussion with the client.",
    href: "",
    available: false,
  },
  {
    number: "S4",
    category: "Software project",
    status: "Coming soon",
    title: "Coming Soon",
    description:
      "Project materials, screenshots, and documentation are being prepared.",
    href: "",
    available: false,
  },
  {
    number: "S5",
    category: "Software project",
    status: "Coming soon",
    title: "Coming Soon",
    description:
      "Project materials, screenshots, and documentation are being prepared.",
    href: "",
    available: false,
  },
];
---

<BaseLayout
  title="Ayana Ahuja — Independent Edition"
  description="Ayana Ahuja — software engineering, quantitative systems, solutions engineering, research, and selected work."
>
  <Header />

  <main>
    <section class="home-hero" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="kicker">
          <span aria-hidden="true"></span>
          Software engineering student
        </p>

        <h1 id="hero-title">
          Building systems and designing
          <span class="highlight">solutions</span>
          <span class="headline-tail">for complex problems.</span>
        </h1>

        <p class="hero-intro">
          Hii, I’m Ayana :) I’m interested in quantitative systems,
          solutions engineering, full-stack development, and basically all the work of translating complicated ideas
          into something clear and useful.
        </p>

        <div class="hero-actions">
          <a class="button button-dark" href="/work">
            Read selected work
            <span aria-hidden="true">→</span>
          </a>

          <a class="button button-light" href="#about">
            About the author
          </a>
        </div>

        <p class="byline">Written &amp; designed by Ayana Ahuja</p>
      </div>

      <figure class="systems-graphic">
        <figcaption>
          Fig. 01 — Structure, rhythm, and technical systems
        </figcaption>

        <svg
          viewBox="0 0 760 620"
          role="img"
          aria-label="Orbit and waveform illustration representing systems, rhythm, probability, and design"
        >
          <defs>
            <linearGradient id="signalInk" x1="40" y1="0" x2="720" y2="0">
              <stop stop-color="#171717" stop-opacity="0" />
              <stop offset="0.18" stop-color="#171717" />
              <stop offset="0.68" stop-color="#971717" />
              <stop offset="1" stop-color="#971717" stop-opacity="0" />
            </linearGradient>
          </defs>

          <ellipse
            cx="390"
            cy="315"
            rx="220"
            ry="220"
            fill="none"
            stroke="#171717"
            stroke-opacity="0.42"
            stroke-width="1.4"
          />

          <ellipse
            cx="390"
            cy="315"
            rx="300"
            ry="105"
            fill="none"
            stroke="#971717"
            stroke-opacity="0.58"
            stroke-width="1.4"
            transform="rotate(18 390 315)"
          />

          <ellipse
            cx="390"
            cy="315"
            rx="270"
            ry="82"
            fill="none"
            stroke="#171717"
            stroke-opacity="0.28"
            stroke-width="1"
            transform="rotate(-26 390 315)"
          />

          <path
            d="M40 320
               C90 320 108 320 136 320
               C170 320 178 254 211 254
               C246 254 248 384 284 384
               C318 384 322 286 356 286
               C390 286 395 347 430 347
               C466 347 470 224 505 224
               C541 224 544 400 580 400
               C616 400 622 294 655 294
               C688 294 701 320 720 320"
            fill="none"
            stroke="url(#signalInk)"
            stroke-width="3"
            stroke-linecap="round"
          />

          <circle
            cx="390"
            cy="315"
            r="67"
            fill="#ffffff"
            stroke="#171717"
            stroke-width="1.6"
          />

          <text
            x="390"
            y="334"
            text-anchor="middle"
            fill="#971717"
            font-family="Georgia, serif"
            font-size="64"
            font-style="italic"
          >
            A
          </text>

          <g
            fill="#171717"
            font-family="'Courier New', monospace"
            font-size="13"
          >
            <text x="76" y="94">structure / rhythm</text>
            <text x="535" y="112">logic / probability</text>
            <text x="84" y="528">design / development</text>
            <text x="535" y="520">systems / solutions</text>
          </g>

          <g
            fill="#971717"
            font-family="Georgia, serif"
            font-size="28"
            font-style="italic"
          >
            <text x="142" y="170"></text>
            <text x="550" y="452">form</text>
          </g>
        </svg>

        <div class="graphic-footer">
          <span>Literature · Music · Technology</span>
          <span>Plate No. 01</span>
        </div>
      </figure>
    </section>

    <section class="section" id="work">
      <div class="section-heading">
        <div>
          <p class="section-number">Section I</p>
          <p class="section-label">Selected work</p>
        </div>

        <h2>Technical work with an editorial point of view.</h2>
      </div>

      <div class="project-list">
        {
          featuredProjects.map((project) => (
            <article class="project-card">
              <div class="project-index">
                <span class="project-number">{project.number}</span>
                <span class="project-status">{project.status}</span>
              </div>

              <div>
                <p class="project-category">{project.category}</p>
                <h3>{project.title}</h3>
                <p class="project-description">{project.description}</p>
              </div>

              {
                project.available ? (
                  <a class="project-link" href={project.href}>
                    Open file
                    <span aria-hidden="true">↗</span>
                  </a>
                ) : (
                  <span class="project-link muted-link">In development</span>
                )
              }
            </article>
          ))
        }
      </div>

      <a class="text-link section-link" href="/work">
        View the complete work archive
        <span aria-hidden="true">→</span>
      </a>
    </section>

    <section class="section" id="software">
      <div class="section-heading">
        <div>
          <p class="section-number">Section II</p>
          <p class="section-label">Software archive</p>
        </div>

        <div>
          <h2>Software projects, experiments, and technical studies.</h2>

          <p class="section-intro">
           A growing archive of projects exploring how systems are designed, tested, and refined.
          </p>
        </div>
      </div>

      <div class="software-grid">
        {
          softwareProjects.map((project) => (
            <article class:list={["software-card", { uploading: !project.available }]}>
              <div class="software-card-top">
                <span class="software-card-number">{project.number}</span>
                <span>{project.status}</span>
              </div>

              <p class="project-category">{project.category}</p>
              <h3>{project.title}</h3>
              <p>{project.description}</p>

              {
                project.available ? (
                  <a class="project-link" href={project.href}>
                    Open project page
                    <span aria-hidden="true">↗</span>
                  </a>
                ) : (
                  <span class="upload-status">Upload in progress</span>
                )
              }
            </article>
          ))
        }
      </div>
    </section>

    <section class="section about-grid" id="about">
      <div>
        <p class="section-number">Section III</p>

        <h2>
          I’m interested in systems, but also in what systems mean to people.
        </h2>
      </div>

      <div class="about-copy">
      <div class="about-left">
        <p class="drop-cap">
         I've always been drawn to and by the systems that make up  
        the world around us. The physical world is beautifully dense with what generations of 
        people have built. The digital world, although relatively established, it is also 
        ever-changing with each new idea very capable of changing its landscape.
        </p>
      </div>
      <div class = "about-right">
        <p>
         That possibility is what excites me. Software is the
        craft by which I make my most direct contribution to that world. The
         various paths that I am pursuing each allow me to engage with complex systems from different
         perspectives.
         
          </p>
          
          <p>
        Through quantitative work, 
        can study one of the systems that quietly
        shapes so much of modern life: financial markets, observed through data,
        probability, risk, and backtesting. Through solutions engineering, I find
        myself at the point where people, problems, and technology meet. Through
        software development, I have the means to build within the digital world
        itself and, in some small way, take part in shaping what it becomes.
        As a young professional, I’m still discovering where these
        paths will lead, but I do know what links them together:

        the same enduring curiosity that has always drawn me toward understanding the world.
        </p>
        


        <blockquote>
          “Basically, I have been compelled by curiosity..”
        </blockquote>
      </div>
      </div>
    </section>

    <section class="section" id="current">
      <div class="section-heading">
        <div>
          <p class="section-number">Section IV</p>
          <p class="section-label">Current focus</p>
        </div>

        <h2>What I am learning and building now.</h2>
      </div>

      <div class="focus-grid">
        <article>
          <span>01</span>
          <h3>Probability &amp; markets</h3>
          <p>
            Learning how assumptions, risk, transaction costs, and overfitting
            change the interpretation of a strategy.
          </p>
        </article>

        <article>
          <span>02</span>
          <h3>Technical discovery</h3>
          <p>
            Practising how to turn an unclear business problem into useful
            questions, requirements, architecture, and tradeoffs.
          </p>
        </article>

        <article>
          <span>03</span>
          <h3>Software foundations</h3>
          <p>
            Strengthening Java, Python, data structures, and the habit of
            explaining technical decisions clearly.
          </p>
        </article>
      </div>
    </section>

    <section class="section writing-preview">
      <div>
        <p class="section-number">Section V</p>
        <p class="section-label">Field notes</p>
      </div>

      <div>
        <p class="publication-label">Published in The Human Variable</p>
        <h2>Longer thoughts, observations, and work in progress.</h2>

        <p class="section-intro">
          My writing is a separate space for reflections, research notes,
          creative work, and questions that need more room than a project card.
        </p>

        <div class="writing-actions">
          <a class="text-link" href="/writing">
            Open writing page
            <span aria-hidden="true">→</span>
          </a>

          <a
            class="text-link"
            href="https://ayana301405.substack.com/"
            target="_blank"
            rel="noopener noreferrer"
          >
            Visit The Human Variable
            <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>

      <div class="writing-symbols" aria-hidden="true">
        <span>&lt;/&gt;</span>
        <span>¶</span>
        <span>∞</span>
      </div>
    </section>

    <section class="section" id="contact">
      <div class="contact-grid">
        <div>
          <p class="section-number">Correspondence</p>
          <h2>Let’s exchange ideas.</h2>

          <div class="contact-copy">
            <p>
              Reach out about internships, technical projects, quantitative
              systems, solutions engineering, collaborative art or technology
              ideas, or simply to exchange thoughts.
            </p>

            <p>
              I’m especially interested in connecting with people who care
              about youth mental health advocacy and encouraging more girls to
              pursue STEM.
            </p>
          </div>
        </div>

        <form
          class="contact-form"
          name="portfolio-contact"
          method="POST"
          data-netlify="true"
          netlify-honeypot="bot-field"
          data-netlify-recaptcha="true"
        >
          <input type="hidden" name="form-name" value="portfolio-contact" />

          <p class="hidden-field">
            <label>
              Leave this field empty:
              <input name="bot-field" />
            </label>
          </p>

          <div class="form-grid">
            <label>
              <span>Name</span>
              <input type="text" name="name" autocomplete="name" required />
            </label>

            <label>
              <span>Email</span>
              <input type="email" name="email" autocomplete="email" required />
            </label>
          </div>

          <label>
            <span>What would you like to discuss?</span>

            <select name="topic" required>
              <option value="" selected disabled>Select a topic</option>
              <option value="internship">Internship or opportunity</option>
              <option value="technical-project">Technical project</option>
              <option value="quantitative-systems">Quantitative systems</option>
              <option value="solutions-engineering">Solutions engineering</option>
              <option value="advocacy">
                Youth mental health or girls in STEM
              </option>
              <option value="creative-collaboration">
                Art or technology collaboration
              </option>
              <option value="other">Something else</option>
            </select>
          </label>

          <label>
            <span>Message</span>
            <textarea name="message" rows="7" required></textarea>
          </label>

          <div data-netlify-recaptcha="true"></div>

          <button class="button button-dark submit-button" type="submit">
            Send correspondence
            <span aria-hidden="true">↗</span>
          </button>
        </form>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .home-hero {
    display: grid;
    min-height: 720px;
    grid-template-columns: minmax(0, 1.03fr) minmax(380px, 0.97fr);
    align-items: center;
    gap: 64px;
    padding: 68px 0 74px;
    border-bottom: 4px double var(--ink);
  }

  .kicker {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 24px;
    color: var(--muted-ink);
  }

  .kicker span {
    width: 22px;
    height: 1px;
    background: var(--accent);
  }

  .highlight {
    display: inline-block;
    padding: 0 0.08em 0.02em;
    background: rgba(80, 80, 80, 0.14);
    font-style: italic;
    transform: rotate(-1deg);
  }

  .headline-tail {
    display: block;
  }

  .hero-intro {
    max-width: 650px;
    margin-bottom: 30px;
    padding-top: 20px;
    border-top: 1px solid var(--line);
    color: #3d3d3d;
    font-size: clamp(1.08rem, 1.55vw, 1.28rem);
    line-height: 1.6;
  }

  .hero-intro::first-letter,
  .drop-cap::first-letter {
    float: left;
    margin: 8px 8px 0 0;
    color: var(--accent);
    font-size: 3.8rem;
    line-height: 0.7;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 34px;
  }

  .byline {
    margin-bottom: 0;
    padding-top: 13px;
    border-top: 1px solid rgba(23, 23, 23, 0.3);
    color: var(--muted-ink);
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.57rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .systems-graphic {
    position: relative;
    min-height: 620px;
    margin: 0;
    overflow: hidden;
    border: 1px solid var(--ink);
    background:
      repeating-linear-gradient(
        to bottom,
        transparent 0,
        transparent 35px,
        rgba(23, 23, 23, 0.07) 35px,
        rgba(23, 23, 23, 0.07) 36px
      ),
      #fff;
    box-shadow:
      14px 14px 0 rgba(151, 23, 23, 0.14),
      24px 24px 0 rgba(23, 23, 23, 0.07),
      inset 0 0 0 8px #fff,
      inset 0 0 0 9px var(--ink);
  }

  .systems-graphic figcaption {
    position: absolute;
    top: 20px;
    right: 22px;
    left: 22px;
    z-index: 2;
    padding-bottom: 9px;
    border-bottom: 1px solid var(--line);
  }

  .systems-graphic svg {
    position: absolute;
    inset: 58px 3% 54px;
    width: 94%;
    height: calc(100% - 112px);
  }

  .graphic-footer {
    position: absolute;
    right: 22px;
    bottom: 18px;
    left: 22px;
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding-top: 9px;
    border-top: 1px solid var(--line);
    color: var(--muted-ink);
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.53rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .section-link {
    margin-top: 25px;
  }

  .muted-link {
    color: var(--muted-ink);
  }

  .section-intro {
    max-width: 720px;
    margin: 22px 0 0;
    color: #404040;
    font-size: 1.05rem;
    line-height: 1.62;
  }

  .about-grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 74px;
  }

  .about-copy {
    columns: 2;
    column-gap: 34px;
    column-rule: 1px solid var(--line);
  }

  .about-copy p {
    break-inside: avoid;
    color: #383838;
    font-size: 1.04rem;
    line-height: 1.68;
  }

  .about-copy blockquote {
    break-inside: avoid;
    margin: 28px 0 0;
    padding: 24px;
    border-top: 1px solid var(--ink);
    border-bottom: 1px solid var(--ink);
    font-size: clamp(1.7rem, 2.6vw, 2.5rem);
    font-style: italic;
    line-height: 1.08;
  }

  .focus-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid var(--ink);
    border-bottom: 1px solid var(--ink);
  }

  .focus-grid article {
    min-height: 275px;
    padding: 27px;
    border-right: 1px solid var(--line);
  }

  .focus-grid article:last-child {
    border-right: 0;
  }

  .focus-grid article > span {
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.61rem;
  }

  .focus-grid h3 {
    margin: 54px 0 14px;
    font-size: clamp(2rem, 3vw, 3.1rem);
    letter-spacing: -0.05em;
    line-height: 0.93;
  }

  .focus-grid p {
    margin-bottom: 0;
    color: #404040;
    line-height: 1.56;
  }

  .writing-preview {
    display: grid;
    grid-template-columns: 0.35fr 1.25fr 0.4fr;
    gap: 48px;
    align-items: center;
  }

  .publication-label {
    margin-bottom: 14px;
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.59rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .writing-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px 22px;
    margin-top: 25px;
  }

  .writing-symbols {
    display: grid;
    min-height: 245px;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: 1fr 1fr;
    border: 1px solid var(--ink);
    background: var(--ink);
    color: #fff;
    box-shadow: 10px 10px 0 rgba(23, 23, 23, 0.14);
    transform: rotate(1.5deg);
  }

  .writing-symbols span {
    display: grid;
    place-items: center;
    border-right: 1px solid #fff;
    border-bottom: 1px solid #fff;
    font-size: 2.5rem;
  }

  .writing-symbols span:nth-child(2) {
    border-right: 0;
  }

  .writing-symbols span:nth-child(3) {
    grid-column: span 2;
    border-right: 0;
    border-bottom: 0;
    font-style: italic;
  }

  .contact-copy {
    max-width: 480px;
    margin-top: 27px;
    color: #3e3e3e;
    font-size: 1.06rem;
    line-height: 1.62;
  }

  .hidden-field {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }

  .submit-button {
    width: 100%;
    margin-top: 8px;
    cursor: pointer;
  }

  @media (max-width: 1000px) {
    .home-hero {
      grid-template-columns: 1fr;
    }

    .systems-graphic {
      width: min(100%, 720px);
      min-height: 620px;
      margin-inline: auto;
    }

    .about-grid {
      grid-template-columns: 1fr;
    }

    .writing-preview {
      grid-template-columns: 0.3fr 1fr;
    }

    .writing-symbols {
      display: none;
    }
  }

  @media (max-width: 760px) {
    .home-hero {
      min-height: auto;
      padding: 54px 0 60px;
    }

    .systems-graphic {
      min-height: 540px;
    }

    .about-copy {
      columns: 1;
    }

    .focus-grid {
      grid-template-columns: 1fr;
    }

    .focus-grid article {
      min-height: auto;
      border-right: 0;
      border-bottom: 1px solid var(--line);
    }

    .focus-grid article:last-child {
      border-bottom: 0;
    }

    .writing-preview {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 520px) {
    .hero-actions {
      flex-direction: column;
    }

    .hero-actions .button {
      width: 100%;
    }

    .systems-graphic {
      min-height: 450px;
    }
  }
</style>

